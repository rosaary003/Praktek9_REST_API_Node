        "id": "mqtt_sensor_09",
        "type": "mqtt in",
        "z": "flow_rest_api_09",
        "name": "Subscribe Sensor",
        "topic": "iot/sensor",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_local_09",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
