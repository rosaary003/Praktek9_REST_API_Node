        "z": "flow_rest_api_09",
        "name": "Build Response Suhu",
        "func": "var data = flow.get('lastSensor') || {suhu:null, kelembaban:null, timestamp:null};\nmsg.payload = {status:'success', data:data, server_time:new Date().toISOString()};\nmsg.headers = {'Access-Control-Allow-Origin':'*'};\nreturn msg;",
