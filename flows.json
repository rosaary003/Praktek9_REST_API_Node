        "type": "http in",
        "z": "flow_rest_api_09",
        "name": "PUT /api/threshold",
        "url": "/api/threshold",
        "method": "put",
        "upload": false,
        "x": 150,
        "y": 520,
        "wires": [
            [
                "function_threshold_09"
            ]
        ]
    },
    {
        "id": "function_threshold_09",
        "type": "function",
        "z": "flow_rest_api_09",
        "name": "Set Batas Suhu",
        "func": "var threshold = Number(msg.payload.threshold);\nif (!Number.isFinite(threshold) || threshold < 0 || threshold > 100) {\n    msg.statusCode = 400;\n    msg.payload = {status:'error', message:'Threshold harus berupa angka 0 sampai 100'};\n} else {\n    flow.set('threshold', threshold);\n    msg.statusCode = 200;\n    msg.payload = {status:'success', message:'Batas suhu berhasil diatur', threshold:threshold};\n}\nmsg.headers = {'Access-Control-Allow-Origin':'*'};\nreturn msg;",
        "outputs": 1,
        "x": 410,
        "y": 520,
        "wires": [
            [
                "response_threshold_09"
            ]
        ]
    },
