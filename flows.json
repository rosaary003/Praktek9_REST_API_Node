    {
        "id": "post_control_09",
        "type": "http in",
        "z": "flow_rest_api_09",
        "name": "POST /api/kontrol",
        "url": "/api/kontrol",
        "method": "post",
        "upload": false,
        "skipBodyParsing": false,
        "swaggerDoc": "",
        "x": 160,
        "y": 390,
        "wires": [
            [
                "process_control_09"
            ]
        ]
    },
    {
        "id": "process_control_09",
        "type": "function",
        "z": "flow_rest_api_09",
        "name": "Validasi & Publish",
        "func": "var body = msg.payload || {};\nif (!body.device || !body.action) {\n    msg.statusCode = 400;\n    msg.payload = {status:'error', message:'device dan action wajib diisi'};\n    msg.headers = {'Access-Control-Allow-Origin':'*'};\n    return [msg, null];\n}\nvar mqttMsg = {payload:body, topic:'iot/kontrol'};\nmsg.statusCode = 200;\nmsg.payload = {status:'success', message:'Perintah terkirim', sent:body};\nmsg.headers = {'Access-Control-Allow-Origin':'*'};\nreturn [msg, mqttMsg];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 390,
        "wires": [
            [
                "http_response_control_09"
            ],
            [
                "mqtt_publish_09"
            ]
        ]
    },
