            [
                "store_sensor_09"
            ]
        ]
    },
    {
        "id": "store_sensor_09",
        "type": "function",
        "z": "flow_rest_api_09",
        "name": "Simpan Data Sensor",
        "func": "var data = msg.payload;\ndata.received = new Date().toISOString();\n\nflow.set('lastSensor', data);\n\nvar history = flow.get('history') || [];\nhistory.push(data);\nif (history.length > 50) history.shift();\nflow.set('history', history);\n\nvar threshold = flow.get('threshold') || 30;\n\nif (Number(data.suhu) > threshold) {\n    node.warn(\"PERINGATAN! Suhu melewati batas: \" + data.suhu + \"°C\");\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 100,
        "wires": [
            [
                "debug_sensor_09"
            ]
        ]
    },
    {
        "id": "debug_sensor_09",
        "type": "debug",
        "z": "flow_rest_api_09",
        "name": "Log Sensor",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
